.TH "AUTOSNAP" "1" "Jun 2026" "autosnap" "autosnap manual"

.SH NAME
autosnap-config-init - Create a repo-local .autosnap.toml


.SH SYNOPSIS
\fBautosnap config init [flags]\fP


.SH DESCRIPTION
Create a repo-local .autosnap.toml


.SH OPTIONS
\fB--force\fP[=false]
	Overwrite existing config

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for init


.SH SEE ALSO
\fBautosnap-config(1)\fP

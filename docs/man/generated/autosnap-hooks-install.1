.TH "AUTOSNAP" "1" "Sep 2026" "autosnap" "autosnap manual"

.SH NAME
autosnap-hooks-install - Install hooks that keep autosnap running


.SH SYNOPSIS
\fBautosnap hooks install [flags]\fP


.SH DESCRIPTION
Install hooks that keep autosnap running


.SH OPTIONS
\fB--force\fP[=false]
	Acknowledge a custom hooks path or back up and chain existing hooks

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for install


.SH SEE ALSO
\fBautosnap-hooks(1)\fP

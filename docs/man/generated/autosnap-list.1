.TH "AUTOSNAP" "1" "Jun 2026" "autosnap" "autosnap manual"

.SH NAME
autosnap-list - List checkpoints


.SH SYNOPSIS
\fBautosnap list [flags]\fP


.SH DESCRIPTION
List checkpoints


.SH OPTIONS
\fB--all\fP[=false]
	List checkpoints for all branches

.PP
\fB--branch\fP=""
	List checkpoints for a specific branch

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list


.SH SEE ALSO
\fBautosnap(1)\fP

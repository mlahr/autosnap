.nh
.TH "AUTOSNAP" "1" "Aug 2026" "autosnap" "autosnap manual"

.SH NAME
autosnap-logs - Show autosnap daemon logs


.SH SYNOPSIS
\fBautosnap logs [flags]\fP


.SH DESCRIPTION
Show autosnap daemon logs


.SH OPTIONS
\fB-f\fP, \fB--follow\fP[=false]
	Follow log output

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for logs

.PP
\fB-n\fP, \fB--tail\fP=-1
	Number of log lines to show from the end (default all)


.SH SEE ALSO
\fBautosnap(1)\fP

.nh
.TH "AUTOSNAP" "1" "Jun 2026" "autosnap" "autosnap manual"

.SH NAME
autosnap-pending - List checkpoints after the latest checkpoint matching branch tip


.SH SYNOPSIS
\fBautosnap pending [flags]\fP


.SH DESCRIPTION
List checkpoints after the latest checkpoint matching branch tip


.SH OPTIONS
\fB--all\fP[=false]
	List pending checkpoints for all branches

.PP
\fB--branch\fP=""
	List pending checkpoints for a specific branch

.PP
\fB--debug\fP[=false]
	Show progress diagnostics on stderr

.PP
\fB--explain\fP[=false]
	Show integration status for all scanned checkpoints

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for pending


.SH SEE ALSO
\fBautosnap(1)\fP

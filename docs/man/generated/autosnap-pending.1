.nh
.TH "AUTOSNAP" "1" "Jun 2026" "autosnap" "autosnap manual"

.SH NAME
autosnap-pending - List checkpoints after the latest checkpoint matching branch tip


.SH SYNOPSIS
\fBautosnap pending [flags]\fP


.SH DESCRIPTION
List checkpoints after the latest checkpoint matching branch tip


.SH OPTIONS
\fB--all\fP[=false]
	List pending checkpoints for all branches

.PP
\fB--branch\fP=""
	List pending checkpoints for a specific branch

.PP
\fB--debug\fP[=false]
	Show progress diagnostics on stderr

.PP
\fB--explain\fP[=false]
	Show integration status for all scanned checkpoints

.PP
\fB--format\fP="text"
	Output format: text, jsonl

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for pending

.PP
\fB--limit\fP=0
	Maximum number of newest checkpoints to scan (0 means unlimited)

.PP
\fB--note-ref\fP=""
	Git notes ref for checkpoint notes

.PP
\fB--notes-json\fP[=false]
	Include checkpoint git notes decoded as JSON (requires --format jsonl)

.PP
\fB--since\fP=""
	Scan checkpoints since a duration or commit ID


.SH SEE ALSO
\fBautosnap(1)\fP

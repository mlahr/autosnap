.TH "AUTOSNAP" "1" "Aug 2026" "autosnap" "autosnap manual"

.SH NAME
autosnap-promote - Promote a checkpoint to a normal branch commit


.SH SYNOPSIS
\fBautosnap promote  [flags]\fP


.SH DESCRIPTION
Promote a checkpoint to a normal branch commit


.SH OPTIONS
\fB--force\fP[=false]
	Skip the clean worktree/index precheck

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for promote


.SH SEE ALSO
\fBautosnap(1)\fP

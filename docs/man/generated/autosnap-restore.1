.TH "AUTOSNAP" "1" "Sep 2026" "autosnap" "autosnap manual"

.SH NAME
autosnap-restore - Restore checkpoint changes into the worktree


.SH SYNOPSIS
\fBautosnap restore  [flags]\fP


.SH DESCRIPTION
Restore checkpoint changes into the worktree


.SH OPTIONS
\fB--force\fP[=false]
	Skip the clean worktree/index precheck

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for restore


.SH SEE ALSO
\fBautosnap(1)\fP

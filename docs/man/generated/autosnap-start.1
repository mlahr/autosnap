.nh
.TH "AUTOSNAP" "1" "Sep 2026" "autosnap" "autosnap manual"

.SH NAME
autosnap-start - Start the autosnap daemon and checkpoint on idle passing checks


.SH SYNOPSIS
\fBautosnap start [flags]\fP


.SH DESCRIPTION
Start the autosnap daemon and checkpoint on idle passing checks


.SH OPTIONS
\fB--check\fP=""
	Shell command to run after idle

.PP
\fB--commit-mode\fP="checkpoint"
	Commit target: checkpoint, direct, sync

.PP
\fB--foreground\fP[=false]
	Run autosnap in the current terminal

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for start

.PP
\fB--idle\fP=60
	Seconds without changes before running the check

.PP
\fB--log-max-bytes\fP=10485760
	Maximum autosnap daemon log size in bytes

.PP
\fB--msg-body-source-cmd\fP=""
	Shell command that returns the checkpoint commit message body

.PP
\fB--msg-source-cmd\fP=""
	Shell command that returns the checkpoint commit message (multiline supported)

.PP
\fB--note-command\fP=""
	Shell command that returns the checkpoint git note content

.PP
\fB--note-ref\fP=""
	Git notes ref for checkpoint notes

.PP
\fB--poll-interval\fP=5s
	Polling interval for poll or auto watch mode

.PP
\fB--post-checkpoint-command\fP=""
	Shell command to run after creating a checkpoint

.PP
\fB--snapshot-mode\fP="both"
	Snapshot source: both, staged, working

.PP
\fB--watch-mode\fP="recursive"
	Watch strategy: recursive, poll, auto


.SH SEE ALSO
\fBautosnap(1)\fP
